# ==========================================
# CO-GLITCH ENVIRONMENT VARIABLES
# ==========================================
# Kopiere diese Datei zu .env und fülle die Werte aus.
# Führe 'make gen-secrets' aus, um sichere Passwörter zu generieren.
# NICHT COMMITTEN!

# ==========================================
# CLIENT (primär) – Pflicht
# ==========================================
TZ="Europe/Berlin"

# AI Provider (mind. OPENCODE_API_KEY setzen; NVIDIA/ZAI optional)
OPENCODE_API_KEY="public"
NVIDIA_API_KEY=""
ZAI_API_KEY=""

# Secrets (von generate-secrets.sh befüllt)
SUPABASE_DB_PASS="GENERATE_ME_SUPABASE_PASS"
POSTIZ_JWT_SECRET="GENERATE_ME_POSTIZ_JWT"
FORGEJO_DB_PASS="GENERATE_ME_FORGEJO_PASS"

# Optional: Ollama lokal
OLLAMA_HOST="http://localhost:11434"

# Optional: Beszel Agent Key (für Monitoring)
BESZEL_AGENT_KEY=""

# ==========================================
# VPS (optional) – nur setzen, wenn make up-vps genutzt wird
# ==========================================
VPS_DOMAIN=""
TAILSCALE_AUTHKEY=""
CADDY_ADMIN_USER="admin"
CADDY_ADMIN_HASH=""

# --- System ---
# --- Docker Registry (optional, für private Images) ---
DOCKER_REGISTRY=""
DOCKER_USERNAME=""
DOCKER_PASSWORD=""