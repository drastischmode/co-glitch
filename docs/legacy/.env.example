# ==========================================
# CO-GLITCH ENVIRONMENT VARIABLES
# ==========================================
# Kopiere diese Datei zu .env und fülle die Werte aus.
# Führe 'make gen-secrets' aus, um sichere Passwörter zu generieren.
# NICHT COMMITTEN!

# --- AI Provider (Trage deine Keys hier ein) ---
# OpenCode Zen: "public" funktioniert oft ohne Account, Key erhöht Limits
OPENCODE_API_KEY="public"

# NVIDIA NIM: Kostenloser Account auf build.nvidia.com
NVIDIA_API_KEY=""

# z.ai / Zhipu: Kostenloser Account auf z.ai
ZAI_API_KEY=""

# --- Core Stack Secrets (werden von generate-secrets.sh befüllt) ---
SUPABASE_DB_PASS="GENERATE_ME_SUPABASE_PASS"
POSTIZ_JWT_SECRET="GENERATE_ME_POSTIZ_JWT"
FORGEJO_DB_PASS="GENERATE_ME_FORGEJO_PASS"
TEMPORAL_DB_PASS="GENERATE_ME_TEMPORAL_PASS"
POSTIZ_DB_PASS="GENERATE_ME_POSTIZ_DB_PASS"

# --- Supabase Auth Keys (werden von generate-secrets.sh befüllt) ---
# Generiere mit: openssl rand -base64 32
SUPABASE_ANON_KEY="GENERATE_ME_SUPABASE_ANON"
SUPABASE_SERVICE_KEY="GENERATE_ME_SUPABASE_SERVICE"
SUPABASE_JWT_SECRET="GENERATE_ME_SUPABASE_JWT"

# --- Supabase Database URL (für MCP Postgres Server) ---
# Format: postgresql://postgres:PASSWORD@HOST:5432/postgres
SUPABASE_DB_URL=""

# --- SMTP für Diun / Alerting (Optional) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Caddy Basic Auth Hashes (generiere mit: caddy hash-password --plaintext 'passwort') ---
CADDY_AUTH_HASH_KUMA=""
CADDY_AUTH_HASH_BESZEL=""
CADDY_AUTH_HASH_DOZZLE=""
CADDY_AUTH_HASH_CADVISOR=""
CADDY_AUTH_HASH_N8N=""

# --- System ---
TZ="Europe/Berlin"

# --- Docker Registry (optional, für private Images) ---
DOCKER_REGISTRY=""
DOCKER_USERNAME=""
DOCKER_PASSWORD=""