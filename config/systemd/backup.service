[Unit]
Description=co-glitch Daily Backup
Documentation=https://github.com/co-glitch/co-glitch/blob/main/docs/05-BACKUP-RESTORE.md
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=%i
WorkingDirectory=%h/co-glitch
ExecStart=%h/co-glitch/scripts/backup.sh
TimeoutSec=600
StandardOutput=journal
StandardError=journal

# Resource Limits
MemoryLimit=500M
CPUQuota=50%

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/co-glitch/backups

[Install]
WantedBy=default.target