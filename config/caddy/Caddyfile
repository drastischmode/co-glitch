# ------------------------------------------
# n8n (Port 8447) - für externe Webhooks
# ------------------------------------------
:8447 {
    basicauth {
        admin {env.CADDY_ADMIN_HASH}
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
    ratelimit {
        zone n8n 200 10s
        key {remote_host}
    }
    reverse_proxy 127.0.0.1:5678 {
        transport http {
            read_timeout 60s
            write_timeout 60s
        }
    }
    log {
        output file /var/log/caddy/n8n-access.log {
            roll_size 10mb
            roll_keep 3
        }
        format json
    }
}