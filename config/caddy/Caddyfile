# Co-Glitch Caddyfile - Tailnet-only Reverse Proxy
# Für VPS: Ports 8443-8447 mit Basic Auth
# Auth-Hash: caddy hash-password --plaintext 'passwort' -> in .env CADDY_ADMIN_HASH

{
    admin off
    auto_https off
}

# Import Environment Variable für Auth
# Format: {env.CADDY_ADMIN_HASH}

# ------------------------------------------
# Uptime Kuma (Port 8443)
# ------------------------------------------
:8443 {
    basicauth {
        admin {env.CADDY_ADMIN_HASH}
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    ratelimit {
        zone kuma 100 10s
        key {remote_host}
    }
    reverse_proxy 127.0.0.1:3001 {
        transport http {
            read_timeout 30s
            write_timeout 30s
        }
    }
    log {
        output file /var/log/caddy/kuma-access.log {
            roll_size 10mb
            roll_keep 3
        }
        format json
    }
}

